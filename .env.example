# ============================================================
# .env.example — Plantilla de variables de entorno (Frontend)
# ============================================================
# Cómo usar:
#   1. Copiar este archivo:        cp .env.example .env
#   2. Editar .env con valores reales
#   3. NUNCA hacer commit del .env (ya está en .gitignore)
# ============================================================


# ─── Servidor Flask ─────────────────────────────────────────
# Puerto donde escucha Flask
PORT=5000
# Modo debug: True solo en desarrollo (NUNCA en producción)
DEBUG=False


# ─── Conexión al Backend ────────────────────────────────────
# Local (con docker compose): http://host.docker.internal:3000
#   (truco que permite al contenedor alcanzar el localhost del host)
# Producción (EC2):           http://IP_PRIVADA_BACKEND:3000
BACKEND_URL=http://host.docker.internal:3000


# ─── Seguridad de Flask ─────────────────────────────────────
# Clave para firmar cookies de sesión.
# En producción debe ser UN STRING LARGO Y ALEATORIO (no este placeholder).
# Para generar una: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar_en_produccion_por_uno_aleatorio


# ─── Docker Hub (para CI/CD y producción) ───────────────────
# Tu usuario de Docker Hub donde se publica la imagen
DOCKERHUB_USERNAME=tu_usuario_dockerhub
# Tag de la imagen a usar
IMAGE_TAG=latest
